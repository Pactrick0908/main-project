generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User[]

  @@map("roles")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(100)
  fullName      String   @map("full_name") @db.VarChar(100)
  googleId      String   @db.VarChar(100)
  walletAddress String   @db.VarChar(100)
  avatarUrl     String   @map("avatar_url") @db.VarChar(255)
  roleId        Int?     @default(1) @map("role_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  role            Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  organizedEvents Event[]
  tickets         Ticket[]
  orders          Order[]

  @@map("users")
}

model Place {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  address   String
  city      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  zones  Zone[]
  events Event[]

  @@map("place")
}

model Zone {
  id       Int     @id @default(autoincrement())
  placeId  Int     @map("place_id")
  name     String  @db.VarChar(100)
  hasSeats Boolean @default(true) @map("has_seats")

  place      Place       @relation(fields: [placeId], references: [id], onDelete: Restrict)
  seats      Seat[]
  eventZones EventZone[]

  @@map("zones")
}

model Seat {
  id         Int    @id @default(autoincrement())
  zoneId     Int    @map("zone_id")
  rowName    String @map("row_name") @db.VarChar(10)
  seatNumber Int    @map("seat_number")

  zone    Zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  tickets Ticket[]

  @@map("seats")
}

model Event {
  id          Int      @id @default(autoincrement())
  organizerId Int      @map("organizer_id")
  placeId     Int      @map("place_id")
  title       String   @db.VarChar(255)
  description String?
  bannerUrl   String?  @map("banner_url") @db.VarChar(500)
  ticketId    String?  @map("ticket_id") @db.VarChar(100)
  status      String?  @default("draft") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  organizer User            @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  place     Place           @relation(fields: [placeId], references: [id], onDelete: Restrict)
  schedules EventSchedule[]
  eventZones EventZone[]
  tickets   Ticket[]

  @@map("events")
}

model EventSchedule {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  startTime DateTime @map("start_time") @db.Timestamp(6)
  endTime   DateTime @map("end_time") @db.Timestamp(6)
  status    String?  @default("open") @db.VarChar(20)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@map("event_schedules")
}

model EventZone {
  id         Int     @id @default(autoincrement())
  eventId    Int     @map("event_id")
  zoneId     Int     @map("zone_id")
  price      Decimal @db.Decimal
  totalSeats Int     @map("total_seats")

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  zone    Zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  tickets Ticket[]

  @@map("event_zones")
}

model Ticket {
  id           Int       @id @default(autoincrement())
  eventId      Int       @map("event_id")
  seatId       Int?      @map("seat_id")
  eventZoneId  Int       @map("event_zone_id")
  status       String?   @default("available") @db.VarChar(50)
  userId       Int?      @map("user_id")
  ownerWallet  String?   @map("owner_wallet") @db.VarChar(100)
  mintAddress  String?   @map("mint_address") @db.VarChar(100)
  checkedInAt  DateTime? @map("checked_in_at") @db.Timestamp(6)
  checkedInBy  String?   @map("checked_in_by") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  event     Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  seat      Seat?         @relation(fields: [seatId], references: [id], onDelete: Restrict)
  eventZone EventZone     @relation(fields: [eventZoneId], references: [id], onDelete: Restrict)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  nonces    TicketNonce[]
  orders    Order[]

  @@index([ownerWallet])
  @@index([userId])
  @@map("tickets")
}

/// Nonce phiên cho Dynamic QR — TTL tối đa 60s, one-time use
model TicketNonce {
  id        String    @id @default(cuid())
  ticketId  Int       @map("ticket_id")
  nonce     String    @unique @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([expiresAt])
  @@map("ticket_nonces")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Order {
  id             Int         @id @default(autoincrement())
  orderCode      BigInt      @unique @map("order_code")
  userId         Int         @map("user_id")
  ticketId       Int?        @map("ticket_id")
  quantity       Int         @default(1)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(15, 2)
  adminAmount    Decimal     @map("admin_amount") @db.Decimal(15, 2)
  systemAmount   Decimal     @map("system_amount") @db.Decimal(15, 2)
  solAmount      Float       @default(0.001) @map("sol_amount")
  status         OrderStatus @default(PENDING)
  solTxSignature String?     @map("sol_tx_signature") @db.VarChar(128)
  paymentLinkId  String?     @map("payment_link_id") @db.VarChar(100)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([orderCode])
  @@index([userId])
  @@map("orders")
}

model AdminBalance {
  id            Int      @id @default(autoincrement())
  totalRevenue  Decimal  @default(0) @map("total_revenue") @db.Decimal(15, 2)
  systemRevenue Decimal  @default(0) @map("system_revenue") @db.Decimal(15, 2)
  lastUpdated   DateTime @default(now()) @updatedAt @map("last_updated") @db.Timestamp(6)

  @@map("admin_balance")
}
