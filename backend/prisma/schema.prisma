generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(100)
  fullName      String   @map("full_name") @db.VarChar(100)
  googleId      String   @db.VarChar(100)
  walletAddress String   @db.VarChar(100)
  avatarUrl     String   @map("avatar_url") @db.VarChar(255)
  role          String?  @default("customer") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  organizedEvents Event[]

  @@map("users")
}

model Place {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  address   String
  city      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  zones  Zone[]
  events Event[]

  @@map("place")
}

model Zone {
  id       Int     @id @default(autoincrement())
  placeId  Int     @map("place_id")
  name     String  @db.VarChar(100)
  hasSeats Boolean @default(true) @map("has_seats")

  place      Place       @relation(fields: [placeId], references: [id], onDelete: Restrict)
  seats      Seat[]
  eventZones EventZone[]

  @@map("zones")
}

model Seat {
  id         Int    @id @default(autoincrement())
  zoneId     Int    @map("zone_id")
  rowName    String @map("row_name") @db.VarChar(10)
  seatNumber Int    @map("seat_number")

  zone    Zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  tickets Ticket[]

  @@map("seats")
}

model Event {
  id          Int      @id @default(autoincrement())
  organizerId Int      @map("organizer_id")
  placeId     Int      @map("place_id")
  title       String   @db.VarChar(255)
  description String?
  bannerUrl   String?  @map("banner_url") @db.VarChar(500)
  ticketId    String?  @map("ticket_id") @db.VarChar(100)
  status      String?  @default("draft") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  organizer User            @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  place     Place           @relation(fields: [placeId], references: [id], onDelete: Restrict)
  schedules EventSchedule[]
  eventZones EventZone[]
  tickets   Ticket[]

  @@map("events")
}

model EventSchedule {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  startTime DateTime @map("start_time") @db.Timestamp(6)
  endTime   DateTime @map("end_time") @db.Timestamp(6)
  status    String?  @default("open") @db.VarChar(20)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@map("event_schedules")
}

model EventZone {
  id         Int     @id @default(autoincrement())
  eventId    Int     @map("event_id")
  zoneId     Int     @map("zone_id")
  price      Decimal @db.Decimal
  totalSeats Int     @map("total_seats")

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  zone    Zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  tickets Ticket[]

  @@map("event_zones")
}

model Ticket {
  id          Int     @id @default(autoincrement())
  eventId     Int     @map("event_id")
  seatId      Int?    @map("seat_id")
  eventZoneId Int     @map("event_zone_id")
  status      String? @default("available") @db.VarChar(50)
  userId      String? @map("user_id") @db.Uuid

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  seat      Seat?     @relation(fields: [seatId], references: [id], onDelete: Restrict)
  eventZone EventZone @relation(fields: [eventZoneId], references: [id], onDelete: Restrict)

  @@map("tickets")
}
